{
  "name": "dsh-chat-find",
  "version": "0.1.0",
  "private": false,
  "description": "在会话聊天区里搜索关键词，高亮所有命中并滚动到对应位置。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "icon.svg"
  ],
  "license": "MIT",
  "author": "shutongX",
  "homepage": "https://github.com/shutongX/dsh-chat-find#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shutongX/dsh-chat-find.git"
  },
  "bugs": {
    "url": "https://github.com/shutongX/dsh-chat-find/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "search",
    "find",
    "chat",
    "cordis"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.1 <3"
  },
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:e2e": "node test/e2e.mjs"
  }
}
